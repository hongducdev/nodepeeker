{
  "name": "nodepeeker",
  "version": "1.0.0",
  "description": "NodePeeker - Figma plugin for CSS & Tailwind inspection, box model, color copier, and 1-click export",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "watch:code": "esbuild src/code/code.ts --bundle --outfile=dist/code.js --target=es2020 --watch",
    "build:code": "esbuild src/code/code.ts --bundle --outfile=dist/code.js --target=es2020",
    "build:ui": "vite build",
    "build": "npm run build:code && npm run build:ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^5.0.1"
  }
}
